// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Application user accounts
model User {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  email         String      @unique
  phone         String?     @unique
  fullName      String
  passwordHash  String
  role          UserRole    @default(OWNER)

  // Relations
  businesses    Business[]
  inspections   Inspection[] @relation("InspectorInspections")
  notifications Notification[]
}

enum UserRole {
  ADMIN
  INSPECTOR
  OWNER
}

/// Registered business
model Business {
  id               String       @id @default(cuid())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  name             String
  category         String
  tin              String?      @unique
  address          String?
  ward             String?
  district         String?
  region           String?

  // Geo
  latitude         Float?
  longitude        Float?
  mapLink          String?

  // Compliance/analytics
  complianceScore  Float        @default(0)

  // Ownership
  ownerId          String
  owner            User         @relation(fields: [ownerId], references: [id])

  // Relations
  licenses         License[]
  inspections      Inspection[]
  notifications    Notification[]
}

/// Business license with autogenerated code and QR
model License {
  id               String        @id @default(cuid())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  licenseCode      String        @unique // e.g., KIL-2025-000123
  status           LicenseStatus @default(PENDING)
  issuedAt         DateTime?
  expiryAt         DateTime?
  renewalCount     Int           @default(0)

  // QR/Verification
  qrCodeSvg        String?
  verificationUrl  String?

  // Relations
  businessId       String
  business         Business      @relation(fields: [businessId], references: [id])
  payments         Payment[]
  penalties        Penalty[]

  @@index([status], map: "idx_license_status")
}

enum LicenseStatus {
  VALID
  PENDING
  EXPIRED
  SUSPENDED
}

/// Payments for licenses
model Payment {
  id              String       @id @default(cuid())
  createdAt       DateTime     @default(now())
  amount          Int
  currency        String       @default("TZS")
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  transactionRef  String?      @unique
  receiptUrl      String?

  licenseId       String
  license         License      @relation(fields: [licenseId], references: [id])
}

enum PaymentMethod {
  MOBILE_MONEY
  CARD
  BANK
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

/// Inspection scheduling and outcomes
model Inspection {
  id             String         @id @default(cuid())
  createdAt      DateTime       @default(now())
  scheduledAt    DateTime?
  status         InspectionStatus @default(SCHEDULED)
  notes          String?
  outcome        String?

  businessId     String
  business       Business       @relation(fields: [businessId], references: [id])

  inspectorId    String?
  inspector      User?          @relation("InspectorInspections", fields: [inspectorId], references: [id])
}

enum InspectionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// Notifications (SMS/Email) with bilingual support
model Notification {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  channel      NotificationChannel
  type         NotificationType
  language     Language       @default(EN)
  subject      String?
  body         String
  sentAt       DateTime?
  status       NotificationStatus @default(PENDING)

  // Scoping
  userId       String?
  user         User?          @relation(fields: [userId], references: [id])
  businessId   String?
  business     Business?      @relation(fields: [businessId], references: [id])
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationType {
  REGISTRATION
  APPROVAL
  RENEWAL
  PENALTY
  INSPECTION
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum Language {
  EN
  SW
}

/// Penalties tied to a license
model Penalty {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  reason      String
  amount      Int
  status      PenaltyStatus @default(UNPAID)

  licenseId   String
  license     License     @relation(fields: [licenseId], references: [id])
}

enum PenaltyStatus {
  UNPAID
  PAID
  WAIVED
}

